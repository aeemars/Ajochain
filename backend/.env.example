# ─── Required ────────────────────────────────────────────────────────
# Arbitrum Sepolia RPC endpoint (Alchemy, Infura, or public)
RPC_URL=https://sepolia-rollup.arbitrum.io/rpc

# Deployed AjoGroup contract address (from Remix deployment)
CONTRACT_ADDRESS=0x_YOUR_AJOGROUP_ADDRESS

# Deployed USDC token address on Arbitrum Sepolia
USDC_ADDRESS=0x_YOUR_USDC_ADDRESS

# Block number from which to start indexing (deploy block for efficiency)
START_BLOCK=0

# ─── Optional: Release Bot ──────────────────────────────────────────
# Private key for the convenience relayer (hex, no 0x prefix)
# Leave empty to disable the auto-release bot
RELAYER_PRIVATE_KEY=

# ─── Server ─────────────────────────────────────────────────────────
PORT=8080
DB_PATH=./ajochain.db
